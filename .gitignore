# Node dependencies
node_modules/
*/node_modules/

# Environment Variables & Secrets (CRITICAL: Never commit to Git)
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
backend/.env
backend/.env.local
backend/.env.*.local
admin/.env
admin/.env.local
admin/.env.*.local

# Production build artifacts
dist/
*/dist/
build/
*/build/

# Backend uploaded files (except .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

